{
  "name": "@faleij/codemirror-lang-ejs",
  "version": "0.1.0",
  "description": "EJS template language support for the CodeMirror code editor",
  "scripts": {
    "test": "cm-runtests",
    "prepare": "cm-buildhelper src/index.ts",
    "example:build": "rollup example/editor.mjs -f iife -o example/editor.bundle.js -p @rollup/plugin-node-resolve",
    "example": "npm run example:build && npx --yes serve example -l 4173",
    "test:compile": "esbuild test/test-syntax.ts test/test-indent.ts test/test-complete.ts --outdir=test --format=esm --platform=node",
    "test:ci": "npm run test:compile && npm test"
  },
  "keywords": [
    "editor",
    "code",
    "ejs",
    "codemirror"
  ],
  "author": {
    "name": "Faleij"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "exports": {
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "sideEffects": false,
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/lang-html": "^6.0.0",
    "@codemirror/lang-javascript": "^6.0.0",
    "@codemirror/language": "^6.6.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.17.0",
    "@lezer/common": "^1.2.0",
    "@lezer/highlight": "^1.0.0",
    "@lezer/lr": "^1.3.3"
  },
  "devDependencies": {
    "@codemirror/buildhelper": "^1.0.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "codemirror": "^6.0.0",
    "esbuild": "^0.25.0",
    "rollup": "^4.24.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Faleij/codemirror-lang-ejs.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ]
}
